{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "mutate": [
    "src/**/*.ts",
    "!src/**/*.test.ts"
  ],
  "testRunner": "command",
  "commandRunner": {
    "command": "node --experimental-strip-types --test --test-timeout=15000 'src/**/*.test.ts'"
  },
  "reporters": [
    "clear-text",
    "progress",
    "html",
    "json"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/mutation.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 60
  },
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true,
  "concurrency": 8,
  "timeoutMS": 25000,
  "coverageAnalysis": "off",
  "tsconfigFile": "no-tsconfig-rewrite.json"
}
