# Copy to `.env` and fill in. `.env` is ignored by git; this file is not, so
# nothing here may ever hold a real value.
#
# Every command that needs these runs through `node --env-file-if-exists=.env`,
# so a key exists for exactly the length of one command and never lives in a
# shell profile.

# api.anthropic.com. Scoped to this project only.
ANTHROPIC_API_KEY=

# Slack app settings → OAuth & Permissions → Bot User OAuth Token.
SLACK_BOT_TOKEN=

# Slack app settings → Basic Information → App-Level Tokens.
# Needs the `connections:write` scope. Only for Socket Mode, which is how this
# runs locally: no public URL, no tunnel.
SLACK_APP_TOKEN=

# Slack app settings → Basic Information → Signing Secret.
# Only for the HTTP endpoint. `src/slack/verify.ts` is the one thing standing
# between a public URL and everything downstream.
SLACK_SIGNING_SECRET=

# Who Brissa translates for: `U123:es,en;U456:de`. The languages are the ones a
# person READS, in the order they prefer — the first is the one messages are
# translated into.
BRISSA_READERS=

# The channels Brissa is switched on in, by id: `C123,C456`. Empty means silent
# everywhere, which is the deliberate first state. Channel ids are printed on
# every line Brissa logs, so inviting it somewhere and writing one message is how
# you find the id to put here.
BRISSA_CHANNELS=

# Measured, not assumed. See docs/DECISIONS.md.
BRISSA_MODEL=claude-sonnet-5

# Reads channel history AS YOU, and only when you ask. `/translate` needs it;
# the message-menu shortcut does not. Slack app settings, after authorising the
# user scopes. Absent is a working state.
SLACK_USER_TOKEN=

# Where enrolment is kept. On Fly this must point at a volume, or every deploy
# forgets everybody. Defaults to data/enrolment.json.
BRISSA_ENROLMENT_PATH=

# Where each person's own Slack token is kept once they connect one. On Fly this
# must be inside the volume. Separate from enrolment on purpose.
BRISSA_TOKENS_PATH=

# Per-user OAuth: all four together or the feature stays off. A partial
# configuration walks somebody through Slack's consent screen to a callback that
# cannot complete, which is a worse answer than "not set up".
#
# The first three are Basic Information → App Credentials.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Also signs the OAuth state. A state signed with an empty string is not signed.
# (Already listed above for the HTTP endpoint; it is required for OAuth too.)
#
# Where Slack sends the browser back. No trailing slash — Slack compares the
# redirect URL character for character against what its settings hold.
BRISSA_PUBLIC_URL=

# Encrypts the token file at rest. 32 bytes, base64 — generate with:
#   openssl rand -base64 32
# Required whenever OAuth is on, because that is when Brissa starts holding
# credentials that are not its own. Keep it in the environment, never on the volume.
BRISSA_TOKENS_KEY=
