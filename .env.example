# Copy to `.env` and fill in. `.env` is ignored by git; this file is not, so
# nothing here may ever hold a real value.
#
# Every command that needs these runs through `node --env-file-if-exists=.env`,
# so a key exists for exactly the length of one command and never lives in a
# shell profile.

# api.anthropic.com. Scoped to this project only.
ANTHROPIC_API_KEY=

# Slack app settings → OAuth & Permissions → Bot User OAuth Token.
SLACK_BOT_TOKEN=

# Slack app settings → Basic Information → App-Level Tokens.
# Needs the `connections:write` scope. Only for Socket Mode, which is how this
# runs locally: no public URL, no tunnel.
SLACK_APP_TOKEN=

# Slack app settings → Basic Information → Signing Secret.
# Only for the HTTP endpoint. `src/slack/verify.ts` is the one thing standing
# between a public URL and everything downstream.
SLACK_SIGNING_SECRET=
